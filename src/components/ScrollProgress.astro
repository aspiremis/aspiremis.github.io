---
/**
 * Reading-progress bar. Uses a scroll-driven CSS animation where supported —
 * that runs off the main thread, so it stays smooth during heavy rendering —
 * and falls back to a passive scroll listener elsewhere.
 */
---

<div
  id="scroll-progress"
  class="pointer-events-none fixed inset-x-0 top-0 z-[55] h-0.5 origin-left scale-x-0 bg-accent"
  role="progressbar"
  aria-label="Reading progress"
  aria-hidden="true"
>
</div>

<style>
  @supports (animation-timeline: scroll()) {
    #scroll-progress {
      animation: scroll-progress linear;
      animation-timeline: scroll(root block);
      transform: scaleX(0);
    }
    @keyframes scroll-progress {
      to { transform: scaleX(1); }
    }
  }
</style>

<script>
  // Only runs where scroll-driven animations aren't available.
  if (!CSS.supports('animation-timeline', 'scroll()')) {
    const bar = document.getElementById('scroll-progress');

    if (bar) {
      let ticking = false;

      const update = () => {
        const scrollable = document.documentElement.scrollHeight - window.innerHeight;
        const ratio = scrollable > 0 ? window.scrollY / scrollable : 0;
        bar.style.transform = `scaleX(${Math.min(1, Math.max(0, ratio))})`;
        ticking = false;
      };

      const onScroll = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      update();
    }
  }
</script>
