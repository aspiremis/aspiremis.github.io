---
/**
 * ⌘K palette — navigation + full-text search in one surface.
 *
 * Written as plain TypeScript instead of pulling in cmdk/React: the whole thing
 * is a few kB and keeps the site at zero framework runtime, which is what
 * protects the Lighthouse budget.
 *
 * Two search layers, both loaded lazily on first open:
 *   • /search-index.json — titles and descriptions, for instant navigation.
 *   • Pagefind — full text of every page, so a phrase buried in a note is
 *     findable. Generated by `pagefind --site dist` after the Astro build.
 */
---

{/*
  The dialog itself is the full-screen overlay. Sizing it with a `fixed` child
  instead would leave the <dialog> with a zero-height box — it renders, but it
  is not a real hit target, which breaks pointer and visibility semantics.
*/}
<dialog
  id="command-palette"
  class="fixed inset-0 m-0 h-dvh max-h-none w-full max-w-none bg-transparent p-0 backdrop:bg-zinc-900/40 backdrop:backdrop-blur-sm dark:backdrop:bg-black/60"
  aria-label="Search and navigation"
>
  <div data-palette-backdrop class="flex h-full items-start justify-center p-4 pt-[10vh]">
    <div
      class="flex max-h-[70vh] w-full max-w-xl flex-col overflow-hidden rounded-2xl border border-line bg-surface shadow-(--shadow-float)"
    >
      <div class="flex items-center gap-3 border-b border-line px-4">
        <svg class="h-4 w-4 shrink-0 text-subtle" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
        </svg>
        <input
          id="palette-input"
          type="search"
          autocomplete="off"
          spellcheck="false"
          placeholder="Search notes, projects, posts…"
          class="h-14 w-full bg-transparent text-[15px] text-fg outline-none placeholder:text-subtle [&::-webkit-search-cancel-button]:hidden"
          aria-label="Search"
          aria-controls="palette-results"
          aria-expanded="true"
        />
        <kbd class="hidden shrink-0 rounded border border-line px-1.5 py-0.5 font-sans text-[10px] font-medium text-subtle sm:block">ESC</kbd>
      </div>

      <ul id="palette-results" class="overflow-y-auto overscroll-contain p-2" role="listbox" aria-label="Results"></ul>

      <div class="flex items-center gap-4 border-t border-line px-4 py-2.5 text-[11px] text-subtle">
        <span><kbd class="font-sans font-medium">↑↓</kbd> navigate</span>
        <span><kbd class="font-sans font-medium">↵</kbd> open</span>
        <span class="ml-auto"><kbd class="font-sans font-medium">esc</kbd> close</span>
      </div>
    </div>
  </div>
</dialog>

<script>
  interface Item {
    title: string;
    href: string;
    section: string;
    description?: string;
    /** Pagefind results carry an HTML excerpt with <mark> around the hit. */
    excerpt?: string;
  }

  const dialog = document.getElementById('command-palette') as HTMLDialogElement | null;
  const input = document.getElementById('palette-input') as HTMLInputElement | null;
  const results = document.getElementById('palette-results');

  if (dialog && input && results) {
    let items: Item[] = [];
    let filtered: Item[] = [];
    let active = 0;
    let loaded = false;
    let pagefind: any = null;
    /** Guards against an older query's results overwriting a newer one's. */
    let queryToken = 0;

    async function load() {
      if (loaded) return;
      loaded = true;
      try {
        const res = await fetch('/search-index.json');
        items = await res.json();
      } catch {
        // Index unavailable — the palette still closes cleanly and the site
        // remains fully navigable through the header.
        items = [];
      }
      render(input!.value);
    }

    /**
     * Pagefind's bundle is generated by `pagefind --site dist` *after* the Astro
     * build, so it doesn't exist during dev or at type-check time. Holding the
     * path in a variable stops both TypeScript and Vite from trying to resolve
     * it statically; if the import fails (dev server, or search not built) the
     * palette silently falls back to title-only results.
     */
    const PAGEFIND_BUNDLE = '/pagefind/pagefind.js';

    async function loadPagefind() {
      if (pagefind !== null) return pagefind;
      try {
        pagefind = await import(/* @vite-ignore */ PAGEFIND_BUNDLE);
        await pagefind.options?.({ excerptLength: 22 });
      } catch {
        pagefind = false;
      }
      return pagefind;
    }

    async function fullTextResults(query: string): Promise<Item[]> {
      const engine = await loadPagefind();
      if (!engine) return [];

      try {
        const search = await engine.search(query);
        const hits = await Promise.all(search.results.slice(0, 6).map((r: any) => r.data()));

        return hits.map((hit: any) => ({
          title: hit.meta?.title ?? hit.url,
          // Astro emits directory-style URLs; strip index.html for clean links.
          href: hit.url.replace(/index\.html$/, ''),
          section: 'Full text',
          excerpt: hit.excerpt,
        }));
      } catch {
        return [];
      }
    }

    /**
     * Subsequence matching, so "pwrflw" finds "Power Flow Solver". Scored so
     * that title hits outrank description hits and earlier matches outrank
     * later ones — good enough for a few hundred entries, no index needed.
     */
    function score(item: Item, query: string): number {
      const q = query.toLowerCase();
      const title = item.title.toLowerCase();

      if (title === q) return 1000;
      if (title.startsWith(q)) return 900 - title.length;
      const idx = title.indexOf(q);
      if (idx > -1) return 700 - idx;

      const haystack = `${title} ${item.description ?? ''} ${item.section}`.toLowerCase();
      if (haystack.includes(q)) return 400;

      let pos = -1;
      for (const char of q) {
        pos = haystack.indexOf(char, pos + 1);
        if (pos === -1) return -1;
      }
      return 100;
    }

    function render(query: string, extra: Item[] = []) {
      const trimmed = query.trim();

      const local = trimmed
        ? items
            .map((item) => ({ item, s: score(item, trimmed) }))
            .filter(({ s }) => s > 0)
            .sort((a, b) => b.s - a.s)
            .slice(0, 8)
            .map(({ item }) => item)
        : items.filter((i) => i.section === 'Pages');

      // Full-text hits for pages the title search already surfaced are noise.
      const seen = new Set(local.map((i) => i.href.replace(/\/$/, '')));
      filtered = [...local, ...extra.filter((i) => !seen.has(i.href.replace(/\/$/, '')))];

      active = 0;

      if (!filtered.length) {
        results!.innerHTML = `<li class="px-3 py-8 text-center text-sm text-(--fg-subtle)">No results for "${escapeHtml(trimmed)}"</li>`;
        return;
      }

      let lastSection = '';
      results!.innerHTML = filtered
        .map((item, i) => {
          const header =
            item.section !== lastSection
              ? `<li role="presentation" class="px-3 pb-1 pt-3 text-[11px] font-semibold uppercase tracking-widest text-(--fg-subtle) first:pt-1">${escapeHtml(item.section)}</li>`
              : '';
          lastSection = item.section;

          // Pagefind's excerpt is trusted markup from our own build (<mark>
          // only); everything else is escaped.
          const sub = item.excerpt
            ? `<span class="mt-0.5 block text-xs leading-snug text-(--fg-subtle) [&_mark]:bg-transparent [&_mark]:font-medium [&_mark]:text-(--accent)">${item.excerpt}</span>`
            : item.description
              ? `<span class="mt-0.5 block truncate text-xs text-(--fg-subtle)">${escapeHtml(item.description)}</span>`
              : '';

          return `${header}<li role="option" aria-selected="${i === active}" data-index="${i}">
            <a href="${item.href}" class="block rounded-lg px-3 py-2.5 aria-[current=true]:bg-(--surface-hover)" data-result>
              <span class="block truncate text-sm font-medium text-(--fg)">${escapeHtml(item.title)}</span>
              ${sub}
            </a>
          </li>`;
        })
        .join('');

      highlight();
    }

    function escapeHtml(value: string): string {
      const el = document.createElement('span');
      el.textContent = value;
      return el.innerHTML;
    }

    function highlight() {
      const links = results!.querySelectorAll<HTMLAnchorElement>('[data-result]');
      links.forEach((link, i) => {
        const selected = i === active;
        link.setAttribute('aria-current', String(selected));
        link.parentElement?.setAttribute('aria-selected', String(selected));
        if (selected) link.scrollIntoView({ block: 'nearest' });
      });
    }

    function open() {
      dialog!.showModal();
      input!.value = '';
      render('');
      load();
      input!.focus();
    }

    document
      .querySelectorAll('[data-command-palette-open]')
      .forEach((trigger) => trigger.addEventListener('click', open));

    document.addEventListener('keydown', (event) => {
      const target = event.target as HTMLElement | null;
      const typing =
        target instanceof HTMLInputElement ||
        target instanceof HTMLTextAreaElement ||
        target?.isContentEditable;

      if (event.key === 'k' && (event.metaKey || event.ctrlKey)) {
        event.preventDefault();
        dialog!.open ? dialog!.close() : open();
        return;
      }
      // Bare "/" is the other muscle-memory shortcut, but only when the user
      // isn't already typing into something.
      if (event.key === '/' && !dialog!.open && !typing) {
        event.preventDefault();
        open();
      }
    });

    input.addEventListener('input', async () => {
      const query = input.value;

      // Paint title matches immediately, then fill in full-text hits when they
      // arrive — the palette never feels like it's waiting on the network.
      render(query);

      const trimmed = query.trim();
      if (trimmed.length < 2) return;

      const token = ++queryToken;
      const extra = await fullTextResults(trimmed);
      if (token === queryToken && input.value === query) render(query, extra);
    });

    dialog.addEventListener('keydown', (event) => {
      /**
       * Escape has to be handled explicitly. `<input type="search">` treats the
       * first Escape as "clear the field" and swallows it, so the dialog's
       * native cancel never fires and the palette appears stuck open. This
       * runs before the results guard so Escape works even with no matches.
       */
      if (event.key === 'Escape') {
        event.preventDefault();
        dialog.close();
        return;
      }

      if (!filtered.length) return;

      if (event.key === 'ArrowDown' || (event.key === 'Tab' && !event.shiftKey)) {
        event.preventDefault();
        active = (active + 1) % filtered.length;
        highlight();
      } else if (event.key === 'ArrowUp' || (event.key === 'Tab' && event.shiftKey)) {
        event.preventDefault();
        active = (active - 1 + filtered.length) % filtered.length;
        highlight();
      } else if (event.key === 'Enter') {
        event.preventDefault();
        const href = filtered[active]?.href;
        if (href) window.location.href = href;
      }
    });

    // Clicking outside the panel closes it. The dialog now fills the viewport,
    // so the click lands on the flex wrapper rather than the dialog itself.
    dialog.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (target === dialog || target.hasAttribute('data-palette-backdrop')) {
        dialog.close();
      }
    });
  }
</script>
