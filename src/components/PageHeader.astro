---
interface Props {
  /** Small uppercase label above the title — orients the reader instantly. */
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, lead, align = 'left' } = Astro.props;
---

<header
  class:list={[
    'mx-auto max-w-(--container-page) px-5 pb-12 pt-16 sm:px-8 sm:pt-24',
    align === 'center' && 'text-center',
  ]}
>
  {
    eyebrow && (
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">{eyebrow}</p>
    )
  }
  <h1 class="mt-3 text-h1 font-semibold text-fg">{title}</h1>
  {
    lead && (
      <p
        class:list={[
          'mt-5 max-w-2xl text-lead text-muted',
          align === 'center' && 'mx-auto',
        ]}
      >
        {lead}
      </p>
    )
  }
  <slot />
</header>
