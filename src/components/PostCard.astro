---
import type { CollectionEntry } from 'astro:content';
import Tag from './Tag.astro';
import { formatDate, readingTime } from '../lib/utils';

interface Props {
  post: CollectionEntry<'blog'>;
  /** `compact` drops the excerpt — used in home-page sidebars. */
  compact?: boolean;
  /**
   * Heading level for the post title. Defaults to h3, which is correct under a
   * section heading. The blog index has no intervening h2, so it passes 'h2' —
   * skipping a level is a real screen-reader navigation failure, not a nitpick.
   */
  headingLevel?: 'h2' | 'h3';
}

const { post, compact = false, headingLevel: Heading = 'h3' } = Astro.props;
const { title, description, date, tags } = post.data;

const minutes = readingTime(post.body ?? '');
---

<article class="group relative border-b border-line py-7 first:pt-0 last:border-0">
  <div class="flex items-center gap-2.5 text-[11px] text-subtle">
    <time datetime={date.toISOString()} class="font-mono">{formatDate(date)}</time>
    <span aria-hidden="true">·</span>
    <span>{minutes} min read</span>
  </div>

  <Heading class:list={['mt-2 font-semibold tracking-tight text-fg', compact ? 'text-base' : 'text-h3']}>
    <a href={`/blog/${post.id}`} class="transition-colors before:absolute before:inset-0 group-hover:text-accent">
      {title}
    </a>
  </Heading>

  {!compact && <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted">{description}</p>}

  {
    !compact && tags.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-1.5">
        {tags.slice(0, 4).map((tag) => (
          <li>
            <Tag tag={tag} />
          </li>
        ))}
      </ul>
    )
  }
</article>
