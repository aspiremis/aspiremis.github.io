---
/**
 * One glyph per track, drawn in the same 2px-stroke language as the site's
 * bus-bar favicon. Inline SVG — no icon font, no extra request, inherits
 * currentColor so it themes for free.
 *
 * The Python mark is two interlocking brackets rather than the official logo,
 * which is a trademark and shouldn't be redrawn as decoration.
 */
interface Props {
  name: string;
  class?: string;
}

const { name, class: className = 'h-5 w-5' } = Astro.props;
// `as const` keeps aria-hidden as the literal "true" rather than widening to
// string, which SVGAttributes rejects when spread.
const common = {
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': '1.7',
  'stroke-linecap': 'round',
  'stroke-linejoin': 'round',
  'aria-hidden': 'true',
} as const;
---

{/* MATLAB — matrix brackets around a 2x2 grid */}
{
  name === 'matrix' && (
    <svg class={className} {...common}>
      <path d="M7 3H4v18h3M17 3h3v18h-3" />
      <circle cx="10" cy="9.5" r="1.1" fill="currentColor" stroke="none" />
      <circle cx="14" cy="9.5" r="1.1" fill="currentColor" stroke="none" />
      <circle cx="10" cy="14.5" r="1.1" fill="currentColor" stroke="none" />
      <circle cx="14" cy="14.5" r="1.1" fill="currentColor" stroke="none" />
    </svg>
  )
}

{/* Python — two interlocking brackets */}
{
  name === 'brackets' && (
    <svg class={className} {...common}>
      <path d="M10 4H8a3 3 0 0 0-3 3v3a3 3 0 0 0 3 3h5" />
      <path d="M14 20h2a3 3 0 0 0 3-3v-3a3 3 0 0 0-3-3h-5" />
      <circle cx="8.5" cy="7.5" r=".9" fill="currentColor" stroke="none" />
      <circle cx="15.5" cy="16.5" r=".9" fill="currentColor" stroke="none" />
    </svg>
  )
}

{/* Power systems — the site's bus-bar motif */}
{
  name === 'bus' && (
    <svg class={className} {...common}>
      <path d="M7 3v18M7 8h9M7 16h9" />
      <circle cx="17.5" cy="8" r="2" />
      <circle cx="17.5" cy="16" r="2" />
    </svg>
  )
}

{/* Mathematics — summation */}
{
  name === 'sigma' && (
    <svg class={className} {...common}>
      <path d="M18 4H6l6 8-6 8h12" />
    </svg>
  )
}

{/* Numerical methods — a converging sequence */}
{
  name === 'convergence' && (
    <svg class={className} {...common}>
      <path d="M3 21h18" />
      <path d="M4 4c3 0 3 12 6 12s3-8 5-8 3 4 6 4" />
      <path d="M3 12h18" stroke-dasharray="2 3" opacity=".5" />
    </svg>
  )
}

{/* Control systems — a feedback loop */}
{
  name === 'feedback' && (
    <svg class={className} {...common}>
      <rect x="8" y="6" width="8" height="6" rx="1.5" />
      <path d="M2 9h6M16 9h6v9H6v-3" />
      <path d="M8.5 17.5 6 15l2.5-2.5" />
    </svg>
  )
}

{/* Signal processing — a waveform */}
{
  name === 'waveform' && (
    <svg class={className} {...common}>
      <path d="M2 12c2 0 2-7 4-7s2 14 4 14 2-11 4-11 2 8 4 8 2-4 4-4" />
    </svg>
  )
}

{/* Optimization — descent to a minimum */}
{
  name === 'descent' && (
    <svg class={className} {...common}>
      <path d="M3 4c4 0 5 13 9 13s5-9 9-9" />
      <circle cx="12" cy="17" r="2" fill="currentColor" stroke="none" />
      <path d="M3 21h18" opacity=".4" />
    </svg>
  )
}

{/* Simulation — nested frames */}
{
  name === 'frames' && (
    <svg class={className} {...common}>
      <rect x="3" y="3" width="14" height="14" rx="2" />
      <path d="M21 7v12a2 2 0 0 1-2 2H7" />
      <path d="M7 10h6M7 13h4" opacity=".6" />
    </svg>
  )
}

{/* Research — an open book */}
{
  name === 'book' && (
    <svg class={className} {...common}>
      <path d="M12 6.5C10.5 5 8.5 4.5 3 4.5v13c5.5 0 7.5.5 9 2 1.5-1.5 3.5-2 9-2v-13c-5.5 0-7.5.5-9 2z" />
      <path d="M12 6.5V21" />
    </svg>
  )
}
