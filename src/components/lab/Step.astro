---
/**
 * One step of a procedure.
 *
 * `expect` is the field that makes this worth a component. A procedure that
 * only tells you what to do leaves you unable to tell a successful step from a
 * failed one until the very end — by which point the error is three steps back.
 * Stating what each step should produce turns the procedure into a chain of
 * checkpoints.
 */
interface Props {
  n: number;
  title?: string;
  /** What you should observe if this step worked. */
  expect?: string;
  /** Raises a red flag on this step only — where the danger actually is. */
  hazard?: string;
}

const { n, title, expect, hazard } = Astro.props;
---

<li>
  <span
    class:list={[
      'absolute left-0 top-0 flex h-8 w-8 items-center justify-center rounded-full border font-mono text-[13px] font-semibold',
      hazard
        ? 'border-red-600/40 bg-red-500/[0.08] text-red-700 dark:text-red-400'
        : 'border-line bg-surface text-muted',
    ]}
    aria-hidden="true">{n}</span
  >

  <div class="pt-1">
    {title && <p class="text-[15px] font-medium text-fg">{title}</p>}

    <div class:list={['step-body text-[15px] leading-relaxed text-muted', title && 'mt-1.5']}>
      <slot />
    </div>

    {
      hazard && (
        <p class="mt-3 flex items-start gap-2 rounded-md border border-red-600/30 bg-red-500/[0.06] px-3 py-2 text-[13px] leading-relaxed text-red-700 dark:text-red-400">
          <svg class="mt-0.5 h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M10.3 3.9 2.4 17.4A2 2 0 0 0 4.1 20.4h15.8a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" />
            <path d="M12 9v4.5M12 17v.5" />
          </svg>
          <span>{hazard}</span>
        </p>
      )
    }

    {
      expect && (
        <p class="mt-3 flex items-start gap-2 text-[13px] leading-relaxed text-subtle">
          <svg class="mt-0.5 h-3.5 w-3.5 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7z" />
            <circle cx="12" cy="12" r="2.5" />
          </svg>
          <span>
            <span class="font-medium text-muted">You should see</span> {expect}
          </span>
        </p>
      )
    }
  </div>
</li>

<style>
  .step-body :global(p) { margin: 0.4rem 0; }
  .step-body :global(p:first-child) { margin-top: 0; }
  .step-body :global(p:last-child) { margin-bottom: 0; }
  .step-body :global(ul),
  .step-body :global(ol) { margin: 0.4rem 0; padding-left: 1.2rem; }
  .step-body :global(li) { margin: 0.2rem 0; }
  .step-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.1em 0.35em;
  }
</style>
