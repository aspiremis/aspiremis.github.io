---
/**
 * A grid of flashcards. Wraps <Flashcard> children.
 */
interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<section class="not-prose my-8">
  {
    title && (
      <p class="mb-4 text-xs font-semibold uppercase tracking-[0.14em] text-subtle">{title}</p>
    )
  }
  <div class="grid gap-4 sm:grid-cols-2">
    <slot />
  </div>
</section>
