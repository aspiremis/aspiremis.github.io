---
/**
 * An empty observation table — columns, units, and nothing else.
 *
 * This is the most important component in the Academy, and the reason is
 * editorial rather than technical. These pages are written BEFORE the
 * experiments are performed, so any number sitting in a results table would be
 * invented. The table therefore ships empty, on purpose, and says so.
 *
 * `rows` sets how many blank lines to draw. Print styling is real here — the
 * expected use is to print the page and fill it in by hand at the bench.
 */
interface Props {
  title?: string;
  /** Column headers. Put the unit in the header, not in every cell. */
  columns: { label: string; unit?: string; derived?: boolean }[];
  rows?: number;
  /** Fixed values for the first column, e.g. a load setting being swept. */
  index?: { label: string; values: string[] };
  caption?: string;
}

const { title, columns, rows = 8, index, caption } = Astro.props;

const bodyRows = index ? index.values.length : rows;
---

<div class="not-prose my-8">
  <div class="mb-3 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <p class="text-xs font-semibold uppercase tracking-[0.14em] text-subtle">
      {title ?? 'Observation table'}
    </p>
    <p class="text-[13px] text-subtle">Empty by design — your readings go here</p>
  </div>

  {/* data-observation-table makes the "always empty" rule testable: a check
      can assert that no body cell outside the index column has content. */}
  <div class="overflow-x-auto rounded-card border border-line">
    <table class="w-full border-collapse text-[14px]" data-observation-table>
      <thead>
        <tr class="bg-bg-subtle">
          {
            index && (
              <th
                scope="col"
                class="border-b border-line px-3 py-2.5 text-left font-medium text-fg whitespace-nowrap"
              >
                {index.label}
              </th>
            )
          }
          {
            columns.map((col) => (
              <th
                scope="col"
                class:list={[
                  'border-b border-line px-3 py-2.5 text-left font-medium whitespace-nowrap',
                  col.derived ? 'text-subtle' : 'text-fg',
                ]}
              >
                {col.label}
                {col.unit && <span class="ml-1 font-mono text-[12px] text-subtle">({col.unit})</span>}
                {col.derived && <span class="ml-1.5 text-[11px] uppercase tracking-wide text-subtle">calc</span>}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          Array.from({ length: bodyRows }).map((_, r) => (
            <tr class="even:bg-bg-subtle/40">
              {index && (
                <td class="border-t border-line px-3 py-2.5 font-mono text-[13px] text-muted whitespace-nowrap">
                  {index.values[r]}
                </td>
              )}
              {columns.map(() => (
                <td class="border-t border-line px-3 py-2.5">
                  <span class="block h-5" aria-hidden="true" />
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  {caption && <p class="mt-3 text-[13px] leading-relaxed text-subtle">{caption}</p>}
</div>

<style>
  /* Printed at the bench and filled in by hand — so give the cells room and
     drop the zebra striping that wastes toner without helping. */
  @media print {
    table { font-size: 12px; }
    td { height: 2.2rem; }
    tbody tr { background: none !important; }
  }
</style>
