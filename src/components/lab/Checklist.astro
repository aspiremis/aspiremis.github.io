---
/**
 * A pre-lab or safety checklist whose ticks survive a reload.
 *
 * Reuses the Learning Hub's localStorage store rather than inventing a second
 * one, so a checklist item is just another id in the same map. That means the
 * export/import escape hatch in the progress panel already covers these.
 *
 * Ids are namespaced `check:<id>:<n>` so they can never collide with a lesson
 * or experiment id, and so clearing lesson progress does not silently clear a
 * safety checklist.
 */
interface Props {
  /** Stable id for this list — the page slug plus a suffix. */
  id: string;
  title?: string;
  items: string[];
  /** Safety lists get the red treatment; pre-lab lists stay neutral. */
  tone?: 'neutral' | 'safety';
}

const { id, title, items, tone = 'neutral' } = Astro.props;

const isSafety = tone === 'safety';
---

<div
  class:list={[
    'not-prose my-8 rounded-card border p-5',
    isSafety ? 'border-red-600/30 bg-red-500/[0.05]' : 'border-line bg-bg-subtle',
  ]}
  data-checklist={id}
>
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <p
      class:list={[
        'text-xs font-semibold uppercase tracking-[0.14em]',
        isSafety ? 'text-red-700 dark:text-red-400' : 'text-subtle',
      ]}
    >
      {title ?? 'Checklist'}
    </p>
    <p class="font-mono text-[13px] text-subtle">
      <span data-checklist-done>0</span>/<span>{items.length}</span>
    </p>
  </div>

  <ul class="mt-4 space-y-0.5">
    {
      items.map((item, i) => (
        <li>
          <label class="group flex cursor-pointer items-start gap-3 rounded-md px-2 py-2 -mx-2 transition-colors hover:bg-surface-hover">
            <input
              type="checkbox"
              class="peer sr-only"
              data-checklist-item={`check:${id}:${i}`}
            />
            <span
              class:list={[
                'mt-0.5 flex h-[18px] w-[18px] shrink-0 items-center justify-center rounded border transition-colors',
                isSafety
                  ? 'border-red-600/40 peer-checked:border-red-600 peer-checked:bg-red-600'
                  : 'border-line-strong peer-checked:border-accent peer-checked:bg-accent',
                /* The tick is a descendant, not a sibling, so peer-checked has
                   to reach into it explicitly. */
                'peer-checked:[&>svg]:opacity-100',
              ]}
              aria-hidden="true"
            >
              <svg
                class="h-3 w-3 text-white opacity-0 transition-opacity"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="m5 12 5 5L20 7" />
              </svg>
            </span>
            <span class="text-[15px] leading-relaxed text-muted transition-colors peer-checked:text-subtle peer-checked:line-through">
              {item}
            </span>
          </label>
        </li>
      ))
    }
  </ul>

  <p class="mt-4 text-[13px] text-subtle">Saved in this browser only.</p>
</div>

<script>
  /**
   * Wires checkboxes to the shared progress store.
   *
   * Runs on astro:page-load as well as initial parse so the ticks are restored
   * after a client-side navigation, not just a full load.
   */
  function wireChecklists() {
    const store = (window as unknown as { learnProgress?: {
      isDone(id: string): boolean;
      set(id: string, done: boolean): boolean;
    } }).learnProgress;
    if (!store) return;

    document.querySelectorAll<HTMLElement>('[data-checklist]').forEach((list) => {
      const boxes = Array.from(
        list.querySelectorAll<HTMLInputElement>('[data-checklist-item]'),
      );
      const counter = list.querySelector('[data-checklist-done]');

      const repaint = () => {
        if (counter) {
          counter.textContent = String(boxes.filter((b) => b.checked).length);
        }
      };

      boxes.forEach((box) => {
        const id = box.dataset.checklistItem!;
        box.checked = store.isDone(id);
        box.addEventListener('change', () => {
          store.set(id, box.checked);
          repaint();
        });
      });

      repaint();
    });
  }

  wireChecklists();
  document.addEventListener('astro:page-load', wireChecklists);
</script>
