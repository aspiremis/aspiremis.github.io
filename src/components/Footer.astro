---
import { SITE, PROFILE, SOCIALS, ALL_PAGES } from '../consts';
import SocialIcon from './SocialIcon.astro';

const year = new Date().getFullYear();

const columns = [
  { heading: 'Explore', links: ALL_PAGES.slice(0, 5) },
  { heading: 'More', links: ALL_PAGES.slice(5) },
];
---

<footer class="mt-32 border-t border-line bg-bg-subtle">
  <div class="mx-auto max-w-(--container-wide) px-5 py-16 sm:px-8">
    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <p class="text-[15px] font-semibold tracking-tight text-fg">{PROFILE.name}</p>
        <p class="mt-2 max-w-sm text-sm leading-relaxed text-muted">
          {PROFILE.role} at {PROFILE.institute}. This site is my open engineering
          notebook — coursework, simulations, notes and the occasional thing that
          finally clicked.
        </p>

        <ul class="mt-6 flex gap-2">
          {
            SOCIALS.map((social) => (
              <li>
                <a
                  href={social.href}
                  class="grid h-9 w-9 place-items-center rounded-lg border border-line text-muted transition-colors hover:border-accent-border hover:bg-accent-tint hover:text-accent"
                  aria-label={social.label}
                  {...(social.icon !== 'mail'
                    ? { target: '_blank', rel: 'me noopener noreferrer' }
                    : {})}
                >
                  <SocialIcon name={social.icon} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {
        columns.map((column) => (
          <nav aria-label={column.heading}>
            <p class="text-xs font-semibold uppercase tracking-widest text-subtle">
              {column.heading}
            </p>
            <ul class="mt-4 space-y-2.5">
              {column.links.map((link) => (
                <li>
                  <a href={link.href} class="text-sm text-muted transition-colors hover:text-accent">
                    {link.label}
                  </a>
                </li>
              ))}
              {column.heading === 'More' && (
                <li>
                  <a href="/rss.xml" class="text-sm text-muted transition-colors hover:text-accent">
                    RSS
                  </a>
                </li>
              )}
            </ul>
          </nav>
        ))
      }
    </div>

    <div
      class="mt-14 flex flex-col gap-3 border-t border-line pt-8 text-xs text-subtle sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {PROFILE.name}. Content licensed CC BY 4.0, code MIT.</p>
      <p class="font-serif italic">{SITE.tagline}</p>
    </div>
  </div>
</footer>
