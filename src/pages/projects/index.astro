---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import { isPublished, byOrderThenDate } from '../../lib/utils';

const projects = (await getCollection('projects', isPublished)).sort(byOrderThenDate);

const active = projects.filter((p) => p.data.status === 'active');
const completed = projects.filter((p) => p.data.status === 'completed');
const planned = projects.filter((p) => p.data.status === 'planned');

const groups = [
  { title: 'In progress', items: active },
  { title: 'Completed', items: completed },
  { title: 'Planned', items: planned },
].filter((group) => group.items.length > 0);
---

<BaseLayout
  title="Projects"
  description="Power system simulation and analysis projects by Shalini Mishra — load flow solvers, PV hosting capacity studies and forecasting work."
  fullTextSearch={false}
>
  <PageHeader
    eyebrow="Work"
    title="Projects"
    lead="Each of these exists because a course raised a question I couldn't answer by reading. They're written up as case studies — problem, approach, what the numbers said, and what I'd do differently."
  />

  <div class="mx-auto max-w-(--container-page) space-y-16 px-5 pb-16 sm:px-8">
    {
      groups.length > 0 ? (
        groups.map((group) => (
          <section aria-labelledby={`group-${group.title.replace(/\s+/g, '-').toLowerCase()}`}>
            <h2
              id={`group-${group.title.replace(/\s+/g, '-').toLowerCase()}`}
              class="text-xs font-semibold uppercase tracking-[0.16em] text-subtle"
            >
              {group.title}
              <span class="ml-2 font-mono normal-case tracking-normal">{group.items.length}</span>
            </h2>

            <div class="mt-6 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
              {group.items.map((project) => (
                <div class="reveal flex">
                  <ProjectCard project={project} />
                </div>
              ))}
            </div>
          </section>
        ))
      ) : (
        <EmptyState
          icon="flask"
          title="No projects published yet"
          description="The first write-ups are in progress."
        />
      )
    }
  </div>
</BaseLayout>
