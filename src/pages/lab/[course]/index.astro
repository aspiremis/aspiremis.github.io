---
import type { GetStaticPaths } from 'astro';

import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import ProgressStore from '../../../components/learning/ProgressStore.astro';
import ProgressRing from '../../../components/learning/ProgressRing.astro';
import { DIFFICULTY, formatDuration } from '../../../lib/learning';
import {
  getCourses,
  getCourseTree,
  experimentPath,
  EXPERIMENT_STATUS,
  PART_STATUS,
} from '../../../lib/lab';
import type { CourseTree } from '../../../lib/lab';

interface Props {
  tree: CourseTree;
}

export const getStaticPaths: GetStaticPaths = async () => {
  const courses = await getCourses();
  const trees = await Promise.all(courses.map((c) => getCourseTree(c.data.id)));

  return trees
    .filter((t): t is CourseTree => t !== null)
    .map((tree) => ({
      params: { course: tree.course.data.id },
      props: { tree },
    }));
};

const { tree } = Astro.props;
const c = tree.course.data;
const allIds = tree.parts.flatMap((p) => p.experiments.map((e) => e.id));
---

<BaseLayout title={c.title} description={c.description} showProgress>
  <ProgressStore />

  <PageHeader eyebrow={c.code ? `${c.code} · Laboratory` : 'Laboratory'} title={c.title} lead={c.description}>
    <div class="mt-10 flex flex-wrap items-center gap-x-10 gap-y-6">
      <ProgressRing lessons={allIds} label={`${c.title} progress`} size={96} />

      <dl class="grid grid-cols-2 gap-x-10 gap-y-4 sm:grid-cols-3">
        <div>
          <dt class="text-xs text-subtle">Experiments written</dt>
          <dd class="mt-0.5 font-mono text-2xl font-semibold text-fg">{tree.experimentCount}</dd>
        </div>
        <div>
          <dt class="text-xs text-subtle">Parts</dt>
          <dd class="mt-0.5 font-mono text-2xl font-semibold text-fg">{tree.parts.length}</dd>
        </div>
        <div>
          <dt class="text-xs text-subtle">Reading time</dt>
          <dd class="mt-0.5 font-mono text-2xl font-semibold text-fg">
            {formatDuration(tree.minutes)}
          </dd>
        </div>
      </dl>
    </div>
  </PageHeader>

  <div class="mx-auto max-w-(--container-wide) px-5 pb-24 sm:px-8">
    {
      tree.parts.map((part) => (
        <section class="mt-16">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b border-line pb-4">
            <h2 class="text-h3 font-semibold tracking-tight text-fg">{part.title}</h2>
            <p class="flex items-baseline gap-2.5 text-[13px]">
              <span class="font-mono text-subtle">
                {part.experiments.length}/{part.count}
              </span>
              <span class={PART_STATUS[part.status].tone}>{part.timing}</span>
            </p>
          </div>

          <p class="mt-4 max-w-(--container-prose) text-[15px] leading-relaxed text-muted">
            {part.description}
          </p>

          <ol class="mt-7 space-y-3">
            {part.experiments.map((experiment) => {
              const d = experiment.data;
              const status = EXPERIMENT_STATUS[d.status];
              const difficulty = DIFFICULTY[d.difficulty];

              return (
                <li>
                  <a
                    href={experimentPath(experiment)}
                    class="group flex gap-5 rounded-card border border-line bg-surface p-5 transition-colors hover:border-accent-border hover:bg-surface-hover"
                    data-lesson-tick={experiment.id}
                  >
                    <span
                      class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-line bg-bg-subtle font-mono text-[15px] font-semibold text-muted"
                      aria-hidden="true"
                    >
                      {d.number}
                    </span>

                    <span class="min-w-0 flex-1">
                      <span class="block text-[16px] font-medium leading-snug text-fg transition-colors group-hover:text-accent">
                        {d.title}
                      </span>
                      <span class="mt-1.5 block text-[14px] leading-relaxed text-muted">
                        {d.description}
                      </span>

                      {d.subparts.length > 0 && (
                        <span class="mt-2.5 flex flex-wrap gap-x-4 gap-y-1">
                          {d.subparts.map((sub) => (
                            <span class="text-[13px] text-subtle">
                              <span class="font-mono">({sub.label})</span> {sub.title}
                            </span>
                          ))}
                        </span>
                      )}

                      <span class="mt-3 flex flex-wrap items-center gap-x-3.5 gap-y-1 text-[13px]">
                        <span class:list={['inline-flex items-center gap-1.5 font-medium', status.tone]}>
                          <span class:list={['h-1.5 w-1.5 rounded-full', status.dot]} aria-hidden="true" />
                          {status.label}
                        </span>
                        <span class="text-subtle" aria-hidden="true">·</span>
                        <span class={difficulty.tone}>{difficulty.label}</span>
                        <span class="text-subtle" aria-hidden="true">·</span>
                        <span class="text-subtle">{formatDuration(d.estimatedMinutes)}</span>
                        {d.simulation.length > 0 && (
                          <>
                            <span class="text-subtle" aria-hidden="true">·</span>
                            <span class="text-subtle">
                              {d.simulation.map((s) => (s === 'matlab' ? 'MATLAB' : 'Python')).join(' + ')}
                            </span>
                          </>
                        )}
                      </span>
                    </span>

                    {d.hazards.length > 0 && (
                      <span class="shrink-0 self-start text-red-700 dark:text-red-400" title="Live hardware">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M10.3 3.9 2.4 17.4A2 2 0 0 0 4.1 20.4h15.8a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" />
                          <path d="M12 9v4.5M12 17v.5" />
                        </svg>
                        <span class="sr-only">This experiment involves live hardware</span>
                      </span>
                    )}
                  </a>
                </li>
              );
            })}

            {/* Declared but unwritten slots. Showing the shape of what's
                coming beats an empty section that looks finished. */}
            {Array.from({ length: part.pending }).map((_, i) => (
              <li>
                <div class="flex gap-5 rounded-card border border-dashed border-line bg-bg-subtle p-5">
                  <span
                    class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-dashed border-line font-mono text-[15px] text-subtle"
                    aria-hidden="true"
                  >
                    {part.experiments.length + i + 1}
                  </span>
                  <span class="min-w-0 flex-1 self-center">
                    <span class="block text-[15px] text-muted">Not yet written</span>
                    <span class="mt-1 block text-[13px] leading-relaxed text-subtle">
                      {part.timing}
                    </span>
                  </span>
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))
    }

    <p class="mt-14 max-w-(--container-prose) text-[13px] leading-relaxed text-subtle">
      Every experiment page is written before the session, not after it. The status on each
      card says whether it has been performed yet — and no observation table on this site
      contains a number I did not measure myself.
    </p>
  </div>
</BaseLayout>
