---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import MathStyles from '../components/MathStyles.astro';
import Badge from '../components/Badge.astro';
import { PROFILE } from '../consts';

const semesters = (await getCollection('journey')).sort((a, b) => a.data.semester - b.data.semester);

// Render every semester body up front — Astro can't await inside the template.
const rendered = await Promise.all(
  semesters.map(async (semester) => ({
    entry: semester,
    Content: (await render(semester)).Content,
  })),
);

const allCourses = semesters.flatMap((s) => s.data.courses);

/** Credits come from the curriculum's own L-T-P-C figures, never derived. */
const totalCredits = allCourses.reduce((sum, c) => sum + (c.credits ?? 0), 0);

/** Per-semester credit subtotal, shown beside each semester heading. */
function creditsFor(courses: { credits?: number }[]): number {
  return courses.reduce((sum, c) => sum + (c.credits ?? 0), 0);
}

const statusTone = { completed: 'done', current: 'active', upcoming: 'planned' } as const;
const statusLabel = { completed: 'Completed', current: 'In progress', upcoming: 'Upcoming' } as const;

/** Sections rendered from frontmatter arrays, skipped when empty. */
const LISTS = [
  { key: 'highlights', heading: 'What stood out' },
  { key: 'labs', heading: 'Lab work' },
  { key: 'conferences', heading: 'Conferences' },
  { key: 'achievements', heading: 'Achievements' },
] as const;
---

<BaseLayout
  title="M.Tech Journey"
  description="Semester-by-semester record of Shalini Mishra's M.Tech in Power Systems Engineering at IIT Bhubaneswar — coursework, labs, reading and research."
  showProgress
>
  <MathStyles />
  <PageHeader
    eyebrow="Two years, documented"
    title="The M.Tech journey"
    lead={`Everything from my M.Tech at ${PROFILE.institute}, organised semester by semester. Semesters that haven't happened yet are plans, and marked as such — I'd rather show the intent than pretend the page is complete.`}
  >
    <dl class="mt-10 grid max-w-lg grid-cols-3 gap-px overflow-hidden rounded-card border border-line bg-line">
      <div class="bg-bg px-5 py-4">
        <dt class="text-xs text-subtle">Semesters</dt>
        <dd class="mt-0.5 font-mono text-2xl font-semibold text-fg">{semesters.length}</dd>
      </div>
      <div class="bg-bg px-5 py-4">
        <dt class="text-xs text-subtle">Courses</dt>
        <dd class="mt-0.5 font-mono text-2xl font-semibold text-fg">
          {semesters.flatMap((s) => s.data.courses).length}
        </dd>
      </div>
      <div class="bg-bg px-5 py-4">
        <dt class="text-xs text-subtle">Credits</dt>
        <dd class="mt-0.5 font-mono text-2xl font-semibold text-fg">
          {totalCredits}<span class="text-sm font-normal text-subtle">/68</span>
        </dd>
      </div>
    </dl>
  </PageHeader>

  <div class="mx-auto max-w-(--container-page) px-5 pb-16 sm:px-8">
    {/* Jump links — with four long semester blocks, this saves a lot of scrolling. */}
    <nav aria-label="Semesters" class="sticky top-16 z-30 -mx-5 mb-12 border-y border-line bg-bg/85 px-5 py-3 backdrop-blur-xl sm:-mx-8 sm:px-8">
      <ul class="flex gap-2 overflow-x-auto">
        {
          semesters.map((semester) => (
            <li>
              <a
                href={`#semester-${semester.data.semester}`}
                class:list={[
                  'inline-flex shrink-0 items-center gap-2 rounded-lg border px-3 py-1.5 text-sm transition-colors',
                  semester.data.status === 'current'
                    ? 'border-accent-border bg-accent-tint text-accent'
                    : 'border-line text-muted hover:bg-surface-hover hover:text-fg',
                ]}
              >
                <span class="font-mono text-xs">S{semester.data.semester}</span>
                <span class="hidden sm:inline">{semester.data.period.split(' ').slice(-2).join(' ')}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="space-y-20">
      {
        rendered.map(({ entry, Content }) => {
          const d = entry.data;
          return (
            <section id={`semester-${d.semester}`} class="reveal scroll-mt-32" aria-labelledby={`heading-s${d.semester}`}>
              <div class="flex flex-wrap items-center gap-3">
                <span
                  class:list={[
                    'grid h-9 w-9 shrink-0 place-items-center rounded-lg border font-mono text-sm font-semibold',
                    d.status === 'current'
                      ? 'border-accent bg-accent text-accent-contrast'
                      : 'border-line bg-bg-subtle text-subtle',
                  ]}
                  aria-hidden="true"
                >
                  {d.semester}
                </span>
                <div>
                  <h2 id={`heading-s${d.semester}`} class="text-h2 font-semibold tracking-tight text-fg">
                    {d.title}
                  </h2>
                  <p class="mt-0.5 font-mono text-xs text-subtle">
                    {d.period}
                    {d.session && <span class="ml-2 text-subtle">· {d.session}</span>}
                  </p>
                </div>
                <Badge tone={statusTone[d.status]} class="ml-auto">
                  {statusLabel[d.status]}
                </Badge>
              </div>

              <p class="mt-6 max-w-2xl text-lead text-muted">{d.summary}</p>

              {d.courses.length > 0 && (
                <div class="mt-10">
                  <h3 class="text-xs font-semibold uppercase tracking-[0.16em] text-subtle">Courses</h3>
                  <div class="mt-4 overflow-x-auto rounded-card border border-line">
                    <table class="w-full border-collapse text-left text-sm">
                      <thead>
                        <tr class="border-b border-line bg-bg-subtle">
                          <th scope="col" class="px-4 py-3 font-medium text-subtle">Code</th>
                          <th scope="col" class="px-4 py-3 font-medium text-subtle">Course</th>
                          <th scope="col" class="whitespace-nowrap px-4 py-3 text-right font-medium text-subtle">
                            L-T-P
                          </th>
                          <th scope="col" class="whitespace-nowrap px-4 py-3 text-right font-medium text-subtle">
                            Cr
                          </th>
                        </tr>
                      </thead>
                      <tbody>
                        {d.courses.map((course) => (
                          <tr class="border-b border-line last:border-0">
                            <td class="whitespace-nowrap px-4 py-3 align-top font-mono text-xs text-subtle">
                              {course.code ?? '—'}
                            </td>
                            <td class="px-4 py-3 align-top">
                              <span class="flex flex-wrap items-center gap-x-2 gap-y-1">
                                <span class="font-medium text-fg">{course.name}</span>
                                {course.type && (
                                  <span
                                    class:list={[
                                      'rounded-full border px-2 py-0.5 text-[10px] font-medium leading-4 whitespace-nowrap',
                                      course.type === 'Core' || course.type === 'Core Lab'
                                        ? 'border-accent-border bg-accent-tint text-accent'
                                        : 'border-line bg-bg-subtle text-subtle',
                                    ]}
                                  >
                                    {course.type}
                                  </span>
                                )}
                              </span>
                              {course.instructor && (
                                <span class="mt-1 block text-xs text-muted">{course.instructor}</span>
                              )}
                              {course.note && (
                                <span class="mt-1 block text-xs leading-relaxed text-subtle">
                                  {course.note}
                                </span>
                              )}
                            </td>
                            <td class="whitespace-nowrap px-4 py-3 text-right align-top font-mono text-xs text-muted">
                              {course.ltp ?? '—'}
                            </td>
                            <td class="whitespace-nowrap px-4 py-3 text-right align-top font-mono text-xs text-fg">
                              {course.credits ?? '—'}
                            </td>
                          </tr>
                        ))}
                        <tr class="border-t border-line-strong bg-bg-subtle">
                          <td colspan="3" class="px-4 py-2.5 text-right text-xs font-medium text-subtle">
                            Semester total
                          </td>
                          <td class="whitespace-nowrap px-4 py-2.5 text-right font-mono text-xs font-semibold text-fg">
                            {creditsFor(d.courses)}
                          </td>
                        </tr>
                      </tbody>
                    </table>
                  </div>
                </div>
              )}

              <div class="mt-10 grid gap-8 sm:grid-cols-2">
                {LISTS.map(({ key, heading }) => {
                  const items = d[key];
                  return items.length > 0 ? (
                    <div>
                      <h3 class="text-xs font-semibold uppercase tracking-[0.16em] text-subtle">
                        {heading}
                      </h3>
                      <ul class="mt-4 space-y-2.5">
                        {items.map((item) => (
                          <li class="flex gap-3 text-sm leading-relaxed text-muted">
                            <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                            {item}
                          </li>
                        ))}
                      </ul>
                    </div>
                  ) : null;
                })}

                {d.books.length > 0 && (
                  <div>
                    <h3 class="text-xs font-semibold uppercase tracking-[0.16em] text-subtle">Reading</h3>
                    <ul class="mt-4 space-y-2.5">
                      {d.books.map((book) => (
                        <li class="text-sm leading-relaxed">
                          <span class="font-serif italic text-fg">{book.title}</span>
                          <span class="text-subtle"> — {book.author}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>

              <div class="prose-notebook prose mt-12 max-w-(--container-prose) border-t border-line pt-10 dark:prose-invert">
                <Content />
              </div>
            </section>
          );
        })
      }
    </div>
  </div>
</BaseLayout>
