---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import MathStyles from '../../components/MathStyles.astro';
import Badge from '../../components/Badge.astro';
import { TOPIC_LABELS } from '../../consts';
import { byOrderThenDate } from '../../lib/utils';

const topics = (await getCollection('learning')).sort(byOrderThenDate);

const rendered = await Promise.all(
  topics.map(async (topic) => ({ entry: topic, Content: (await render(topic)).Content })),
);

const STATUS_LABEL = {
  exploring: 'Exploring',
  'in-progress': 'In progress',
  consolidating: 'Consolidating',
  paused: 'Paused',
} as const;

const STATUS_TONE = {
  exploring: 'planned',
  'in-progress': 'active',
  consolidating: 'accent',
  paused: 'neutral',
} as const;

const averageProgress = topics.length
  ? Math.round(topics.reduce((sum, t) => sum + t.data.progress, 0) / topics.length)
  : 0;
---

<BaseLayout
  title="Learning"
  description="What Shalini Mishra is currently studying — power systems, simulation, power quality, machine learning — with honest progress against each."
  showProgress
>
  <MathStyles />
  <PageHeader
    eyebrow="Learning · Progress"
    title="What I'm studying"
    lead="A running record of what I'm working through and how far in I actually am. The percentages are my own honest estimate of coverage, not a grade — the point is to see where the gaps are, including by admitting them. For the structured courses I'm writing, see the Learning Hub."
  >
    <div class="mt-8 flex flex-wrap items-center gap-6 text-sm text-subtle">
      <span><span class="font-mono text-fg">{topics.length}</span> active topics</span>
      <span><span class="font-mono text-fg">{averageProgress}%</span> average coverage</span>
    </div>
  </PageHeader>

  <div class="mx-auto max-w-(--container-page) px-5 pb-16 sm:px-8">
    <div class="space-y-6">
      {
        rendered.map(({ entry, Content }) => {
          const d = entry.data;
          return (
            <article class="reveal overflow-hidden rounded-card border border-line bg-surface">
              <div class="border-b border-line p-6 sm:p-8">
                <div class="flex flex-wrap items-start justify-between gap-4">
                  <div class="min-w-0">
                    <p class="font-mono text-[11px] uppercase tracking-wider text-accent">
                      {TOPIC_LABELS[d.topic]}
                    </p>
                    <h2 class="mt-2 text-h2 font-semibold tracking-tight text-fg">{d.title}</h2>
                    <p class="mt-3 max-w-2xl leading-relaxed text-muted">{d.description}</p>
                  </div>
                  <Badge tone={STATUS_TONE[d.status]}>{STATUS_LABEL[d.status]}</Badge>
                </div>

                <div class="mt-7 flex items-center gap-4">
                  <div
                    class="h-1.5 flex-1 overflow-hidden rounded-full bg-line"
                    role="progressbar"
                    aria-valuenow={d.progress}
                    aria-valuemin="0"
                    aria-valuemax="100"
                    aria-label={`${d.title} coverage`}
                  >
                    <div class="h-full rounded-full bg-accent transition-[width] duration-700" style={`width:${d.progress}%`} />
                  </div>
                  <span class="shrink-0 font-mono text-xs text-subtle">{d.progress}%</span>
                </div>
              </div>

              <div class="prose-notebook prose max-w-none p-6 dark:prose-invert sm:p-8">
                <Content />
              </div>
            </article>
          );
        })
      }
    </div>

    <div class="mt-16 rounded-card border border-dashed border-line-strong bg-bg-subtle/50 p-8 text-center">
      <p class="text-sm text-muted">
        Structured lessons live in the
        <a href="/learning" class="text-accent link-underline">Learning Hub</a>; the books,
        tools and datasets behind all of this are on the
        <a href="/resources" class="text-accent link-underline">resources page</a>.
      </p>
    </div>
  </div>
</BaseLayout>
