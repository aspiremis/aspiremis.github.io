---
import { getCollection } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Badge from '../../components/Badge.astro';
import ProgressStore from '../../components/learning/ProgressStore.astro';
import ProgressRing from '../../components/learning/ProgressRing.astro';
import TrackIcon from '../../components/learning/TrackIcon.astro';
import ContinueLearning from '../../components/learning/ContinueLearning.astro';
import ProgressPanel from '../../components/learning/ProgressPanel.astro';
import { getAllTrackTrees, formatDuration } from '../../lib/learning';
import { TOPIC_LABELS } from '../../consts';
import { byOrderThenDate } from '../../lib/utils';

const trees = await getAllTrackTrees();
const allLessonIds = trees.flatMap((t) => t.modules.flatMap((m) => m.lessons.map((l) => l.id)));

const written = allLessonIds.length;
const totalMinutes = trees.reduce((sum, t) => sum + t.minutes, 0);

// The existing "what I'm studying" entries — kept as a strip so the hub shows
// self-assessed coverage alongside lesson completion. Two different measures of
// the same thing, and both are honest.
const studying = (await getCollection('learning'))
  .sort(byOrderThenDate)
  .filter((entry) => entry.data.status !== 'paused')
  .slice(0, 6);
---

<BaseLayout
  title="Learning Hub"
  description="A first-principles course in MATLAB and Python for power system engineering — built by Shalini Mishra while learning it, from zero programming to solving real problems."
  showProgress
>
  <ProgressStore />

  <PageHeader
    eyebrow="Learning Hub"
    title="Learning to compute, from first principles"
    lead="My coursework assumes I already know MATLAB. Nobody teaches it. So I'm writing the course I wanted — starting from why a language like this exists, and ending at a load-flow solver I wrote myself. Python follows."
  >
    <div class="mt-10 flex flex-wrap items-center gap-x-10 gap-y-6">
      <ProgressRing lessons={allLessonIds} label="Overall Learning Hub progress" size={104} />

      <dl class="grid grid-cols-2 gap-x-10 gap-y-4 sm:grid-cols-3">
        <div>
          <dt class="text-xs text-subtle">Tracks</dt>
          <dd class="mt-0.5 font-mono text-2xl font-semibold text-fg">{trees.length}</dd>
        </div>
        <div>
          <dt class="text-xs text-subtle">Lessons written</dt>
          <dd class="mt-0.5 font-mono text-2xl font-semibold text-fg">{written}</dd>
        </div>
        <div>
          <dt class="text-xs text-subtle">Reading time</dt>
          <dd class="mt-0.5 font-mono text-2xl font-semibold text-fg">
            {formatDuration(totalMinutes)}
          </dd>
        </div>
      </dl>
    </div>
  </PageHeader>

  <div class="mx-auto max-w-(--container-page) space-y-20 px-5 pb-16 sm:px-8">
    <ContinueLearning trees={trees} />

    {/* ------------------------------------------------------------ Roadmap */}
    <section aria-labelledby="roadmap-heading">
      <SectionHeader
        id="roadmap-heading"
        title="The roadmap"
        description="Ordered deliberately. Numerical methods comes before power system applications, because implementing a load flow without understanding conditioning produces code that works on five buses and fails on five hundred."
      />

      <ol class="mt-10 space-y-4">
        {
          trees.map((tree, index) => {
            const ids = tree.modules.flatMap((m) => m.lessons.map((l) => l.id));
            const planned = tree.track.data.status === 'planned';
            // A planned track has nowhere to go yet, so it must not be an
            // anchor — an <a> without href is neither crawlable nor focusable,
            // and announces itself as a link that does nothing.
            const Card = planned ? 'div' : 'a';

            return (
              <li
                class="reveal relative"
                data-progress-group={ids.join(',')}
                style={`transition-delay:${index * 50}ms`}
              >
                <Card
                  {...(planned ? {} : { href: `/learning/${tree.track.id}` })}
                  class:list={[
                    'block rounded-card border p-6 transition-[border-color,background-color]',
                    planned
                      ? 'border-dashed border-line-strong bg-bg-subtle/40'
                      : 'group border-line bg-surface hover:border-line-strong hover:bg-surface-hover',
                  ]}
                >
                  <div class="flex flex-wrap items-start gap-x-5 gap-y-4">
                    <span
                      class:list={[
                        'grid h-11 w-11 shrink-0 place-items-center rounded-lg border',
                        planned
                          ? 'border-line text-subtle'
                          : 'border-accent-border bg-accent-tint text-accent',
                      ]}
                    >
                      <TrackIcon name={tree.track.data.icon} />
                    </span>

                    <div class="min-w-0 flex-1">
                      <div class="flex flex-wrap items-center gap-3">
                        <h3
                          class:list={[
                            'text-h3 font-semibold tracking-tight',
                            planned ? 'text-muted' : 'text-fg transition-colors group-hover:text-accent',
                          ]}
                        >
                          {tree.track.data.title}
                        </h3>
                        {planned && <Badge tone="planned">Planned</Badge>}
                      </div>

                      <p class="mt-1.5 text-sm leading-relaxed text-muted">
                        {tree.track.data.tagline}
                      </p>

                      {tree.lessonCount > 0 && (
                        <div class="mt-4 flex items-center gap-3">
                          <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-line">
                            <div
                              class="h-full rounded-full bg-accent transition-[width] duration-700"
                              style="width:0%"
                              data-progress-bar
                            />
                          </div>
                          <span class="shrink-0 font-mono text-[11px] text-subtle">
                            <span data-progress-done>0</span>/<span data-progress-total>
                              {tree.lessonCount}
                            </span>
                          </span>
                        </div>
                      )}

                      {/* Module chips give the shape of the track at a glance
                          without needing to open it. */}
                      <ul class="mt-4 flex flex-wrap gap-1.5">
                        {tree.modules.map((entry) => (
                          <li
                            class:list={[
                              'rounded-md border px-2 py-0.5 text-[11px]',
                              entry.lessons.length
                                ? 'border-line bg-bg-subtle text-muted'
                                : 'border-dashed border-line text-subtle',
                            ]}
                          >
                            {entry.module.data.title}
                            {entry.lessons.length > 0 && (
                              <span class="ml-1 font-mono text-subtle">{entry.lessons.length}</span>
                            )}
                          </li>
                        ))}
                      </ul>
                    </div>

                    {!planned && tree.lessonCount > 0 && (
                      <span class="shrink-0 self-center text-subtle transition-transform group-hover:translate-x-0.5" aria-hidden="true">
                        →
                      </span>
                    )}
                  </div>
                </Card>
              </li>
            );
          })
        }
      </ol>
    </section>

    {/* ------------------------------------------------------ Studying strip */}
    <section aria-labelledby="studying-heading">
      <SectionHeader
        id="studying-heading"
        title="Currently studying"
        description="Self-assessed coverage of the subjects themselves, separate from lesson completion above."
        href="/learning/progress"
        linkLabel="Full detail"
      />

      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          studying.map((entry) => (
            <li class="reveal rounded-card border border-line bg-surface p-5">
              <p class="font-mono text-[11px] uppercase tracking-wider text-subtle">
                {TOPIC_LABELS[entry.data.topic]}
              </p>
              <h3 class="mt-1.5 text-sm font-semibold text-fg">{entry.data.title}</h3>
              <div class="mt-3 flex items-center gap-3">
                <div
                  class="h-1 flex-1 overflow-hidden rounded-full bg-line"
                  role="progressbar"
                  aria-valuenow={entry.data.progress}
                  aria-valuemin="0"
                  aria-valuemax="100"
                  aria-label={`${entry.data.title} coverage`}
                >
                  <div class="h-full rounded-full bg-accent" style={`width:${entry.data.progress}%`} />
                </div>
                <span class="font-mono text-[11px] text-subtle">{entry.data.progress}%</span>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <ProgressPanel />
  </div>
</BaseLayout>
