---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import Badge from '../components/Badge.astro';
import GitHubCalendar from '../components/GitHubCalendar.astro';
import RepoList from '../components/RepoList.astro';
import { SITE, PROFILE, TOPIC_LABELS } from '../consts';
import { isPublished, byDateDesc, byOrderThenDate } from '../lib/utils';

const projects = (await getCollection('projects', isPublished))
  .filter((p) => p.data.featured)
  .sort(byOrderThenDate)
  .slice(0, 3);

const posts = (await getCollection('blog', isPublished)).sort(byDateDesc).slice(0, 4);

const semesters = (await getCollection('journey')).sort((a, b) => a.data.semester - b.data.semester);
const currentSemester = semesters.find((s) => s.data.status === 'current');

const learning = (await getCollection('learning'))
  .sort(byOrderThenDate)
  .filter((l) => l.data.status === 'in-progress' || l.data.status === 'consolidating')
  .slice(0, 4);

const notes = await getCollection('notes', isPublished);
const papers = await getCollection('papers');

const RESEARCH_INTERESTS = [
  {
    title: 'Renewable grid integration',
    body: 'How much distributed PV a network can absorb, what limit binds first, and what changes that answer.',
  },
  {
    title: 'Power quality',
    body: 'Harmonics and voltage disturbances in networks increasingly fed by inverters rather than machines.',
  },
  {
    title: 'Distribution system analysis',
    body: 'Unbalanced, resistive, radial networks — where most of the transmission-shaped intuition stops applying.',
  },
  {
    title: 'Data-driven methods',
    body: 'Where forecasting and analytics genuinely beat a physical model, and where they only appear to.',
  },
];

const stats = [
  { value: String(projects.length + 0), label: 'Projects' },
  { value: String(posts.length), label: 'Posts' },
  { value: String(notes.length), label: 'Notes' },
  { value: String(papers.length), label: 'Papers read' },
];
---

<BaseLayout title={SITE.title} description={SITE.description}>
  {/* ---------------------------------------------------------------- Hero */}
  <section class="relative overflow-hidden">
    <div class="grid-backdrop pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

    <div class="mx-auto max-w-(--container-page) px-5 pb-20 pt-20 sm:px-8 sm:pb-28 sm:pt-32">
      <div class="reveal">
        <a
          href={PROFILE.instituteUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full border border-accent-border bg-accent-tint px-3 py-1 text-xs font-medium text-accent transition-colors hover:border-accent"
        >
          <span class="relative flex h-1.5 w-1.5" aria-hidden="true">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-60"></span>
            <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-accent"></span>
          </span>
          M.Tech Power Systems · IIT Bhubaneswar
        </a>

        <h1 class="mt-7 max-w-4xl text-display font-semibold text-fg">
          Understanding the grid,<br class="hidden sm:block" />
          <span class="text-muted">one simulation at a time.</span>
        </h1>

        <p class="mt-7 max-w-2xl text-lead text-muted">
          I'm Shalini — a power systems engineer in the making, working on renewable
          integration, distribution networks and the software that makes both
          analysable. This site is my open engineering notebook rather than a
          résumé: what I'm building, what I'm reading, and what I got wrong on the
          way.
        </p>
      </div>

      <div class="reveal mt-9 flex flex-wrap gap-3" style="transition-delay:80ms">
        <a
          href="/projects"
          class="inline-flex h-11 items-center rounded-lg bg-accent px-5 text-sm font-medium text-accent-contrast transition-colors hover:bg-accent-hover"
        >
          See what I'm building
        </a>
        <a
          href="/journey"
          class="inline-flex h-11 items-center rounded-lg border border-line bg-surface px-5 text-sm font-medium text-fg transition-colors hover:border-line-strong hover:bg-surface-hover"
        >
          Follow the M.Tech journey
        </a>
      </div>

      {/* Current focus — the one line that dates fastest, so it lives in consts.ts */}
      <div
        class="reveal mt-14 max-w-2xl rounded-card border border-line bg-surface/60 p-5 backdrop-blur-sm"
        style="transition-delay:160ms"
      >
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-subtle">
          Currently
        </p>
        <p class="mt-2.5 text-[15px] leading-relaxed text-muted">{PROFILE.currentFocus}</p>
      </div>

      <dl class="reveal mt-14 grid max-w-2xl grid-cols-2 gap-px overflow-hidden rounded-card border border-line bg-line sm:grid-cols-4" style="transition-delay:220ms">
        {
          stats.map((stat) => (
            <div class="bg-bg px-5 py-4">
              <dt class="text-xs text-subtle">{stat.label}</dt>
              <dd class="mt-0.5 font-mono text-2xl font-semibold tracking-tight text-fg">
                {stat.value}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {/* ------------------------------------------------------------ Projects */}
  <section class="mx-auto max-w-(--container-page) px-5 py-20 sm:px-8" aria-labelledby="projects-heading">
    <div class="reveal">
      <SectionHeader
        id="projects-heading"
        title="What I'm building"
        description="Each one exists because a course raised a question I couldn't answer by reading."
        href="/projects"
        linkLabel="All projects"
      />
    </div>

    <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((project, index) => (
          <div class="reveal flex" style={`transition-delay:${index * 70}ms`}>
            <ProjectCard project={project} />
          </div>
        ))
      }
    </div>
  </section>

  {/* ------------------------------------------------- Journey + Research */}
  <section class="border-y border-line bg-bg-subtle">
    <div class="mx-auto grid max-w-(--container-page) gap-16 px-5 py-20 sm:px-8 lg:grid-cols-2">
      <div class="reveal" aria-labelledby="journey-heading">
        <SectionHeader
          id="journey-heading"
          title="The journey"
          description="Four semesters, documented as they happen."
          href="/journey"
          linkLabel="Full timeline"
        />

        <ol class="mt-8 space-y-0">
          {
            semesters.map((semester) => (
              <li class="relative flex gap-5 pb-8 last:pb-0">
                {/* Connector line, suppressed on the final item */}
                <span
                  class="absolute left-[15px] top-8 h-full w-px bg-line last:hidden [li:last-child_&]:hidden"
                  aria-hidden="true"
                />
                <span
                  class:list={[
                    'relative z-10 grid h-8 w-8 shrink-0 place-items-center rounded-full border font-mono text-xs font-semibold',
                    semester.data.status === 'current'
                      ? 'border-accent bg-accent text-accent-contrast'
                      : 'border-line bg-bg text-subtle',
                  ]}
                >
                  {semester.data.semester}
                </span>

                <div class="min-w-0 pt-1">
                  <div class="flex flex-wrap items-center gap-2">
                    <a href="/journey" class="text-sm font-semibold text-fg transition-colors hover:text-accent">
                      {semester.data.title}
                    </a>
                    {semester.data.status === 'current' && <Badge tone="active">Now</Badge>}
                  </div>
                  <p class="mt-0.5 font-mono text-[11px] text-subtle">{semester.data.period}</p>
                  <p class="mt-2 text-sm leading-relaxed text-muted">{semester.data.summary}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="reveal" aria-labelledby="research-heading" style="transition-delay:100ms">
        <SectionHeader
          id="research-heading"
          title="Research interests"
          description="Where I want the next two years to point."
          href="/research"
          linkLabel="Research"
        />

        <ul class="mt-8 grid gap-4 sm:grid-cols-2">
          {
            RESEARCH_INTERESTS.map((interest) => (
              <li class="rounded-card border border-line bg-surface p-5">
                <h3 class="text-sm font-semibold text-fg">{interest.title}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-muted">{interest.body}</p>
              </li>
            ))
          }
        </ul>

        {
          currentSemester && (
            <div class="mt-6 rounded-card border border-line bg-surface p-5">
              <p class="text-xs font-semibold uppercase tracking-[0.16em] text-subtle">
                This semester
              </p>
              <ul class="mt-3 space-y-1.5">
                {currentSemester.data.courses.map((course) => (
                  <li class="flex gap-3 text-sm">
                    <span class="shrink-0 font-mono text-xs text-subtle">{course.code}</span>
                    <span class="text-muted">{course.name}</span>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </div>
  </section>

  {/* ------------------------------------------------- Writing + Learning */}
  <section class="mx-auto max-w-(--container-page) px-5 py-20 sm:px-8">
    <div class="grid gap-16 lg:grid-cols-[1.4fr_1fr]">
      <div class="reveal" aria-labelledby="writing-heading">
        <SectionHeader
          id="writing-heading"
          title="Latest writing"
          description="Longer pieces, usually written the week something finally made sense."
          href="/blog"
          linkLabel="All posts"
        />
        <div class="mt-8">
          {posts.map((post) => <PostCard post={post} />)}
        </div>
      </div>

      <div class="reveal" aria-labelledby="learning-heading" style="transition-delay:100ms">
        <SectionHeader
          id="learning-heading"
          title="Learning now"
          href="/learning"
          linkLabel="All topics"
        />

        <ul class="mt-8 space-y-5">
          {
            learning.map((item) => (
              <li>
                <div class="flex items-baseline justify-between gap-3">
                  <a
                    href="/learning"
                    class="text-sm font-medium text-fg transition-colors hover:text-accent"
                  >
                    {item.data.title}
                  </a>
                  <span class="shrink-0 font-mono text-[11px] text-subtle">
                    {item.data.progress}%
                  </span>
                </div>
                <p class="mt-1 text-xs text-subtle">{TOPIC_LABELS[item.data.topic]}</p>
                <div
                  class="mt-2 h-1 overflow-hidden rounded-full bg-line"
                  role="progressbar"
                  aria-valuenow={item.data.progress}
                  aria-valuemin="0"
                  aria-valuemax="100"
                  aria-label={`${item.data.title} progress`}
                >
                  <div class="h-full rounded-full bg-accent" style={`width:${item.data.progress}%`}></div>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------- GitHub + quote */}
  <section class="border-t border-line bg-bg-subtle">
    <div class="mx-auto max-w-(--container-page) px-5 py-20 sm:px-8">
      <div class="reveal grid gap-12 lg:grid-cols-[1.3fr_1fr]">
        <div class="rounded-card border border-line bg-surface p-6">
          <GitHubCalendar />
        </div>

        <div>
          <h3 class="mb-4 text-sm font-semibold text-fg">Recent repositories</h3>
          <RepoList limit={3} />
        </div>
      </div>

      <blockquote class="reveal mx-auto mt-20 max-w-2xl text-center">
        <p class="font-serif text-h2 italic leading-snug text-fg">
          “The grid is the largest machine humans have ever built, and it has to
          balance itself every single second.”
        </p>
        <footer class="mt-5 text-sm text-subtle">
          — the sentence that made me choose power systems
        </footer>
      </blockquote>

      <div class="reveal mt-16 flex flex-col items-center gap-4 text-center">
        <p class="text-lead text-muted">Working on something in this space?</p>
        <a
          href="/contact"
          class="inline-flex h-11 items-center rounded-lg bg-accent px-6 text-sm font-medium text-accent-contrast transition-colors hover:bg-accent-hover"
        >
          Get in touch
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
