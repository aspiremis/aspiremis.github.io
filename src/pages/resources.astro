---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Card from '../components/Card.astro';
import { TOPIC_LABELS } from '../consts';

const resources = await getCollection('resources');

const KINDS = [
  { key: 'book', label: 'Books', blurb: 'The references I keep going back to.' },
  { key: 'tool', label: 'Tools', blurb: 'Software I use for simulation and analysis.' },
  { key: 'reference', label: 'Standards & references', blurb: 'Worth reading directly rather than in summary.' },
  { key: 'dataset', label: 'Datasets', blurb: 'Test systems and open data for validation.' },
  { key: 'course', label: 'Courses', blurb: 'Structured material that was worth the time.' },
  { key: 'community', label: 'Communities', blurb: 'Where the field talks to itself.' },
] as const;

const grouped = KINDS.map((kind) => ({
  ...kind,
  items: resources
    .filter((r) => r.data.kind === kind.key)
    // Recommended first, then alphabetical.
    .sort((a, b) =>
      Number(b.data.recommended) - Number(a.data.recommended) ||
      a.data.title.localeCompare(b.data.title),
    ),
})).filter((group) => group.items.length > 0);
---

<BaseLayout
  title="Resources"
  description="Books, tools, standards and datasets for power systems engineering — curated by Shalini Mishra, with notes on why each earns its place."
  showProgress
>
  <PageHeader
    eyebrow="Learning"
    title="Resources"
    lead="What I actually use, with a line on why. Everything marked with a star is something I'd recommend without hesitation to another power systems student."
  />

  <div class="mx-auto max-w-(--container-page) space-y-16 px-5 pb-16 sm:px-8">
    {
      grouped.map((group) => (
        <section aria-labelledby={`kind-${group.key}`}>
          <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
            <h2 id={`kind-${group.key}`} class="text-h3 font-semibold tracking-tight text-fg">
              {group.label}
            </h2>
            <p class="text-sm text-subtle">{group.blurb}</p>
          </div>

          <div class="mt-6 grid gap-4 md:grid-cols-2">
            {group.items.map((resource) => (
              <div class="reveal flex">
                <Card href={resource.data.url} external={Boolean(resource.data.url)} class="p-5">
                  <div class="flex items-start gap-3">
                    <div class="min-w-0 flex-1">
                      <h3 class="flex items-start gap-2 text-[15px] font-semibold leading-snug text-fg transition-colors group-hover:text-accent">
                        {resource.data.recommended && (
                          <span class="mt-0.5 shrink-0 text-accent" title="Strongly recommended" aria-label="Strongly recommended">
                            ★
                          </span>
                        )}
                        <span>{resource.data.title}</span>
                      </h3>
                      {resource.data.author && (
                        <p class="mt-1 text-xs text-subtle">{resource.data.author}</p>
                      )}
                    </div>
                    {resource.data.url && (
                      <span class="shrink-0 text-subtle transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" aria-hidden="true">
                        ↗
                      </span>
                    )}
                  </div>

                  <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">
                    {resource.data.description}
                  </p>

                  {resource.data.topics.length > 0 && (
                    <ul class="mt-4 flex flex-wrap gap-1.5">
                      {resource.data.topics.map((topic) => (
                        <li class="rounded-md bg-bg-subtle px-2 py-0.5 font-mono text-[11px] text-subtle">
                          {TOPIC_LABELS[topic]}
                        </li>
                      ))}
                    </ul>
                  )}
                </Card>
              </div>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>
