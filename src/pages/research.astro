---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeader from '../components/SectionHeader.astro';
import EmptyState from '../components/EmptyState.astro';
import Badge from '../components/Badge.astro';
import Tag from '../components/Tag.astro';
import { TOPIC_LABELS, SITE } from '../consts';
import { formatDate } from '../lib/utils';

const papers = (await getCollection('papers')).sort(
  (a, b) => b.data.readOn.valueOf() - a.data.readOn.valueOf(),
);
const publications = await getCollection('publications');

const INTERESTS = [
  {
    title: 'Renewable integration in distribution networks',
    body: 'Hosting capacity, voltage rise and the operational limits that decide how much distributed PV a feeder can actually take. My current work sits here, and I expect my thesis to as well.',
    questions: [
      'How conservative is worst-case snapshot analysis compared with full time-series simulation?',
      'How much does inverter volt-var control move the answer, relative to modelling detail?',
    ],
  },
  {
    title: 'Power quality under high inverter penetration',
    body: 'Most classical power quality material assumes rotating machines dominate. That assumption is becoming less true every year, and I want to understand what changes when it fails.',
    questions: [
      'What does harmonic propagation look like on a feeder that is already substantially inverter-fed?',
      'Do the IEEE 519 current limits still achieve what they were designed to achieve?',
    ],
  },
  {
    title: 'Data-driven methods for power systems',
    body: 'Forecasting, anomaly detection and analytics — with a strong interest in identifying where a physical model is simply the better answer.',
    questions: [
      'Where does a physics-informed model beat both a pure ML model and a pure physical one?',
      'What is the right way to report forecast uncertainty so an operator can act on it?',
    ],
  },
];

const FUTURE_WORK = [
  {
    title: 'Quasi-static time series hosting capacity',
    body: 'Move from worst-case snapshots to a full year at hourly or sub-hourly resolution, and quantify the conservatism the snapshot introduces.',
  },
  {
    title: 'Hosting capacity on real Indian feeders',
    body: 'The IEEE test feeders are a starting point, not an endpoint. Indian distribution networks differ in topology, loading and phase balance in ways that likely matter.',
  },
  {
    title: 'Probabilistic forecasting for distribution planning',
    body: 'Quantile forecasts rather than point forecasts, evaluated on calibration as well as sharpness.',
  },
  {
    title: 'Protection in inverter-dominated networks',
    body: 'A Semester 2 interest for now. Current-limited inverter fault contribution breaks assumptions built into conventional overcurrent coordination.',
  },
];
---

<BaseLayout
  title="Research"
  description="Research interests, publications, papers read and future directions — Shalini Mishra, M.Tech Power Systems Engineering, IIT Bhubaneswar."
  showProgress
>
  <PageHeader
    eyebrow="Research"
    title="What I'm working towards"
    lead="I'm early — one semester in, with no publications yet. What I do have is a set of questions I keep returning to, and a reading list that is starting to point somewhere. This page tracks both honestly."
  />

  <div class="mx-auto max-w-(--container-page) space-y-24 px-5 pb-16 sm:px-8">
    {/* ---------------------------------------------------------- Interests */}
    <section aria-labelledby="interests-heading">
      <SectionHeader
        id="interests-heading"
        title="Research interests"
        description="Three areas, and the specific open questions inside each that I'd actually like to answer."
      />

      <div class="mt-10 space-y-5">
        {
          INTERESTS.map((interest) => (
            <article class="reveal rounded-card border border-line bg-surface p-6 sm:p-8">
              <h3 class="text-h3 font-semibold text-fg">{interest.title}</h3>
              <p class="mt-3 max-w-3xl leading-relaxed text-muted">{interest.body}</p>

              <ul class="mt-6 space-y-2.5 border-l-2 border-accent-border pl-5">
                {interest.questions.map((question) => (
                  <li class="font-serif text-[17px] italic leading-relaxed text-fg">{question}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    {/* ------------------------------------------------------- Publications */}
    <section aria-labelledby="publications-heading">
      <SectionHeader
        id="publications-heading"
        title="Publications"
        description="Nothing here yet — I started my M.Tech in July 2026. This section is built and waiting."
      />

      <div class="mt-10">
        {
          publications.length > 0 ? (
            <ul class="space-y-4">
              {publications.map((publication) => (
                <li class="rounded-card border border-line bg-surface p-6">
                  <div class="flex flex-wrap items-center gap-2">
                    <Badge tone="accent">{publication.data.type}</Badge>
                    <Badge>{publication.data.status}</Badge>
                  </div>
                  <h3 class="mt-3 text-h3 font-semibold text-fg">{publication.data.title}</h3>
                  <p class="mt-2 text-sm text-muted">{publication.data.authors.join(', ')}</p>
                  <p class="mt-1 text-sm text-subtle">
                    {publication.data.venue}, {publication.data.year}
                  </p>
                  {publication.data.url && (
                    <a
                      href={publication.data.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="mt-4 inline-block text-sm text-accent link-underline"
                    >
                      Read it ↗
                    </a>
                  )}
                </li>
              ))}
            </ul>
          ) : (
            <EmptyState
              icon="document"
              title="No publications yet"
              description="Targeting a first conference submission from my thesis Phase I work in late 2027. When there is something real to list, it will appear here."
            />
          )
        }
      </div>
    </section>

    {/* -------------------------------------------------------- Papers read */}
    <section aria-labelledby="papers-heading">
      <SectionHeader
        id="papers-heading"
        title="Papers I've read"
        description="Logged with the takeaway that made each one worth the time. A reading list without takeaways is just a list."
      />

      <div class="mt-10 space-y-4">
        {
          papers.map((paper) => (
            <article class="reveal rounded-card border border-line bg-surface p-6">
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <h3 class="text-base font-semibold leading-snug text-fg">
                  {paper.data.url ? (
                    <a
                      href={paper.data.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="transition-colors hover:text-accent"
                    >
                      {paper.data.title} <span aria-hidden="true">↗</span>
                    </a>
                  ) : (
                    paper.data.title
                  )}
                </h3>
              </div>

              <p class="mt-1.5 text-sm text-muted">{paper.data.authors.join(', ')}</p>
              <p class="mt-0.5 font-mono text-xs text-subtle">
                {paper.data.venue}, {paper.data.year}
                <span class="mx-2" aria-hidden="true">·</span>
                read {formatDate(paper.data.readOn)}
              </p>

              <blockquote class="mt-4 border-l-2 border-accent-border pl-4">
                <p class="font-serif text-[17px] leading-relaxed text-fg">{paper.data.takeaway}</p>
              </blockquote>

              <div class="mt-4 flex flex-wrap items-center gap-1.5">
                <span class="rounded-md border border-line bg-bg-subtle px-2 py-0.5 font-mono text-[11px] text-muted">
                  {TOPIC_LABELS[paper.data.topic]}
                </span>
                {paper.data.tags.slice(0, 3).map((tag) => <Tag tag={tag} />)}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    {/* -------------------------------------------------------- Future work */}
    <section aria-labelledby="future-heading">
      <SectionHeader
        id="future-heading"
        title="Where this goes next"
        description="Directions I intend to pursue, in rough order of how soon."
      />

      <ol class="mt-10 grid gap-4 sm:grid-cols-2">
        {
          FUTURE_WORK.map((item, index) => (
            <li class="reveal rounded-card border border-line bg-surface p-6">
              <span class="font-mono text-xs text-accent">{String(index + 1).padStart(2, '0')}</span>
              <h3 class="mt-2 text-base font-semibold text-fg">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{item.body}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="rounded-card border border-line bg-bg-subtle p-8 text-center sm:p-12">
      <h2 class="text-h3 font-semibold text-fg">Working on something related?</h2>
      <p class="mx-auto mt-3 max-w-xl leading-relaxed text-muted">
        I'm always glad to hear from people working on distribution-level renewable
        integration, power quality, or energy analytics — whether that's a
        collaboration, a dataset, or a paper I should have read by now.
      </p>
      <a
        href={`mailto:${SITE.email}`}
        class="mt-7 inline-flex h-11 items-center rounded-lg bg-accent px-6 text-sm font-medium text-accent-contrast transition-colors hover:bg-accent-hover"
      >
        Email me
      </a>
    </section>
  </div>
</BaseLayout>
