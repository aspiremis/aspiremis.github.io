---
import type { MarkdownHeading } from 'astro';

import BaseLayout from './BaseLayout.astro';
import MathStyles from '../components/MathStyles.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ProgressStore from '../components/learning/ProgressStore.astro';
import CodeTools from '../components/learning/CodeTools.astro';
import MarkComplete from '../components/learning/MarkComplete.astro';
import LabIcon from '../components/lab/LabIcon.astro';
import Spec from '../components/lab/Spec.astro';
import { DIFFICULTY, formatDuration } from '../lib/learning';
import { INSTRUMENT_CATEGORIES, experimentPath, instrumentPath } from '../lib/lab';
import type { Instrument, Experiment } from '../lib/lab';

interface Props {
  instrument: Instrument;
  headings: MarkdownHeading[];
  usedIn: Experiment[];
  previous: Instrument | null;
  next: Instrument | null;
}

const { instrument, headings, usedIn, previous, next } = Astro.props;
const d = instrument.data;
const difficulty = DIFFICULTY[d.difficulty];
const category = INSTRUMENT_CATEGORIES.find((c) => c.id === d.category);
---

<BaseLayout
  title={d.title}
  description={d.description}
  type="article"
  publishedAt={d.updated}
  tags={d.tags}
  showProgress
>
  <MathStyles />
  <ProgressStore />
  <CodeTools />

  <article class="mx-auto max-w-(--container-wide) px-5 pt-10 sm:px-8 sm:pt-14">
    <div class="mx-auto max-w-(--container-prose)">
      <nav aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-1.5 text-[13px] text-subtle">
          <li><a href="/lab" class="transition-colors hover:text-accent">Laboratory</a></li>
          <li aria-hidden="true">/</li>
          <li>
            <a href="/lab/instruments" class="transition-colors hover:text-accent">Instruments</a>
          </li>
          <li aria-hidden="true">/</li>
          <li class="text-muted">{category?.label}</li>
        </ol>
      </nav>

      <header class="mt-7">
        <div class="flex items-start gap-4">
          <span class="mt-1 shrink-0 text-accent">
            <LabIcon name={d.icon} class="h-8 w-8" />
          </span>
          <div class="min-w-0">
            <h1 class="text-h1 font-semibold tracking-tight text-fg">{d.title}</h1>
            <p class="mt-2 text-[15px] text-subtle">{d.tagline}</p>
          </div>
        </div>

        <p class="mt-5 text-lead text-muted">{d.description}</p>

        <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 text-[13px]">
          <span class:list={['font-medium', difficulty.tone]}>{difficulty.label}</span>
          <span class="text-subtle" aria-hidden="true">·</span>
          <span class="text-subtle">{formatDuration(d.estimatedMinutes)}</span>
        </div>

        {
          d.hazards.length > 0 && (
            <ul class="mt-5 flex flex-wrap gap-2">
              {d.hazards.map((hazard) => (
                <li class="inline-flex items-center gap-1.5 rounded-md border border-red-600/30 bg-red-500/[0.06] px-2.5 py-1 text-[13px] text-red-700 dark:text-red-400">
                  <svg class="h-3 w-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M10.3 3.9 2.4 17.4A2 2 0 0 0 4.1 20.4h15.8a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" />
                    <path d="M12 9v4.5M12 17v.5" />
                  </svg>
                  {hazard}
                </li>
              ))}
            </ul>
          )
        }

        {
          usedIn.length > 0 && (
            <div class="mt-8 rounded-card border border-line bg-bg-subtle p-6">
              <p class="text-xs font-semibold uppercase tracking-[0.14em] text-subtle">
                You will use this in
              </p>
              <ul class="mt-3 space-y-2">
                {usedIn.map((experiment) => (
                  <li>
                    <a
                      href={experimentPath(experiment)}
                      class="group flex items-baseline gap-2.5 text-[15px] text-muted transition-colors hover:text-accent"
                    >
                      <span class="font-mono text-[13px] text-subtle">
                        {experiment.data.number}
                      </span>
                      <span class="transition-colors group-hover:text-accent">
                        {experiment.data.title}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        {/* Rendered from frontmatter rather than written into the body, so the
            same figures are available to cards and comparisons later without
            being parsed back out of prose. */}
        {d.specs.length > 0 && <Spec rows={d.specs} />}
      </header>
    </div>

    <div class="mt-12 lg:grid lg:grid-cols-[1fr_minmax(0,var(--container-prose))_1fr] lg:gap-10">
      <div class="hidden lg:block" aria-hidden="true"></div>

      <div class="lesson-body prose-notebook prose max-w-none dark:prose-invert">
        <slot />
      </div>

      <aside class="hidden lg:block">
        <div class="sticky top-24 max-h-[calc(100vh-8rem)] overflow-y-auto pb-8">
          <TableOfContents headings={headings} />
        </div>
      </aside>
    </div>

    <div class="mx-auto mt-16 max-w-(--container-prose)">
      <div class="flex flex-wrap items-center gap-4 border-t border-line pt-8">
        <MarkComplete lessonId={instrument.id} />
        <p class="text-[13px] text-subtle">Saved in this browser only.</p>
      </div>

      <nav class="mt-8 grid gap-4 sm:grid-cols-2" aria-label="Instrument navigation">
        {
          previous ? (
            <a
              href={instrumentPath(previous)}
              class="group rounded-card border border-line bg-surface p-5 transition-colors hover:border-line-strong hover:bg-surface-hover"
            >
              <span class="text-xs text-subtle">← Previous</span>
              <span class="mt-1 block text-sm font-medium text-fg transition-colors group-hover:text-accent">
                {previous.data.shortTitle ?? previous.data.title}
              </span>
            </a>
          ) : (
            <div />
          )
        }

        {
          next ? (
            <a
              href={instrumentPath(next)}
              class="group rounded-card border border-line bg-surface p-5 text-right transition-colors hover:border-line-strong hover:bg-surface-hover"
            >
              <span class="text-xs text-subtle">Next →</span>
              <span class="mt-1 block text-sm font-medium text-fg transition-colors group-hover:text-accent">
                {next.data.shortTitle ?? next.data.title}
              </span>
            </a>
          ) : (
            <a
              href="/lab/instruments"
              class="group rounded-card border border-accent-border bg-accent-tint p-5 text-right transition-colors"
            >
              <span class="text-xs text-accent">End of the written instruments</span>
              <span class="mt-1 block text-sm font-medium text-accent">All instruments</span>
            </a>
          )
        }
      </nav>
    </div>
  </article>
</BaseLayout>
